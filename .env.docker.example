# Copy this file to `.env.docker` and fill in real values, then run:
#   docker compose --env-file .env.docker up --build
#
# `.env.docker` itself is gitignored.

# --- NextAuth ---
# Any random 32+ chars, base64 is fine:
#   openssl rand -base64 32
SECRET=change-me-random-32-chars
AUTH_SECRET=change-me-random-32-chars

# --- Google OAuth ---
# From https://console.cloud.google.com/apis/credentials
# For local testing, add http://localhost:3000/api/auth/callback/google
# to the "Authorized redirect URIs" of your OAuth client.
GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_SECRET=your-google-client-secret
